# Desenvolvimento: execute python setup_local.py para gerar SECRET_KEY.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Produção exige PostgreSQL, DEBUG=0, domínio e uploads persistentes.
# DATABASE_URL=postgresql://resenha:SENHA_FORTE@database:5432/resenha
# TRUST_PROXY=1 somente atrás de proxy confiável que substitui X-Forwarded-Proto.
TRUST_PROXY=0
PERSISTENT_MEDIA=0

# Alternativa ao disco persistente: bucket privado compatível com S3.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker Compose: defina uma senha forte e não versionada.
POSTGRES_PASSWORD=
